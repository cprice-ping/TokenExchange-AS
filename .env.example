AS_ISSUER=http://localhost:8000
TOKEN_CLIENT_ID=tokenexchange
TOKEN_CLIENT_SECRET=change-me
SIGNING_KEY_PATH=./dev-signing-key.pem
SIGNING_KEY_ALGORITHM=RS256
SIGNING_KEY_ID=as-development
TOKEN_TTL_SECONDS=300
TOKEN_MAX_TTL_SECONDS=300
# actor_token is optional; P1AZ authorizes subject-only and actor-present exchanges.
CLOCK_SKEW_SECONDS=30
ALLOW_INSECURE_HTTP=true
# Audience/resource authorization is decided by PingOne Authorize.
# Scope authorization is decided by PingOne Authorize.
P1AZ_MODE=enforce
P1AZ_AUTH_BASE=https://auth.pingone.com
P1AZ_API_BASE=https://api.pingone.com/v1
P1AZ_ENVIRONMENT_ID=
P1AZ_DECISION_ENDPOINT_ID=
P1AZ_WORKER_CLIENT_ID=
P1AZ_WORKER_CLIENT_SECRET=
P1AZ_TIMEOUT_SECONDS=5
P1AZ_TOKEN_SAFETY_SECONDS=60
# Declared access tokens are opaque locally: P1AZ policy validates them
# (RFC 7662 introspection at the issuer) and decides authorization.
