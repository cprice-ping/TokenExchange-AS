[{"@class":"DataStreamHeader","kind":"SnapshotHeader","version":2},{"type":"SnapshotPackageFile$PackageHeader","snapshotId":"b5cf7050-a8af-11f1-8563-a9a8fa954323","snapshotFileVersion":2,"applicationVersion":"P1AZ-1.0.0.0"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Introspection","id":"9e3eee3b-e5d3-4e38-a890-d69f8d1420d1","name":"Introspection","numberOfChildren":3,"parentId":null,"repetitionSource":null,"resolvers":[],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"34e4068f-d6f9-439f-b612-c122ebe44c30"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"Parent attribute for all PingOne attributes\nThis attribute does not resolve to a value and should not be used in policies.","fullName":"PingOne","id":"b530f05b-a30d-4932-87e9-fabd65121ec3","managedEntity":{"owner":{"service":{"name":"Editor Service"}},"restrictions":{"disallowChildren":true,"readOnly":true}},"name":"PingOne","numberOfChildren":1,"parentId":null,"repetitionSource":null,"resolvers":null,"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"ca0116a0-3eae-4359-bdb6-0899d2aac116"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"ID of the user the decision request is being made on behalf of\nThis value is resolved from the userContext.userId property of the decision request.","fullName":"PingOne.User.ID","id":"5c357b78-e4a3-4c5f-9716-bd8fd718ac64","managedEntity":{"owner":{"service":{"name":"Editor Service"}},"restrictions":{"disallowChildren":true,"readOnly":true}},"name":"ID","numberOfChildren":null,"parentId":"c9c69ef1-4623-4913-81d4-75466831777d","repetitionSource":null,"resolvers":[{"attributeResolverType":"currentUserId","condition":null,"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"79502252-0e70-42ae-855a-6cdf2eca0ea6"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request","id":"74350cc3-d01d-4d43-a8e7-1486619c0ce2","name":"Request","numberOfChildren":1,"parentId":null,"repetitionSource":null,"resolvers":[],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"50e7fee7-1b06-4797-a61c-9f9531cedb21"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request.TokenExchange","id":"4270cdd7-2b6a-4539-a29d-b9f0f56a762a","name":"TokenExchange","numberOfChildren":4,"parentId":"74350cc3-d01d-4d43-a8e7-1486619c0ce2","repetitionSource":null,"resolvers":[],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"04e99e7c-7d13-4b73-89a8-59177f54f478"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request.TokenExchange.Actor","id":"13ae049a-9748-4669-b991-1b9989db4ba0","name":"Actor","numberOfChildren":4,"parentId":"4270cdd7-2b6a-4539-a29d-b9f0f56a762a","repetitionSource":null,"resolvers":[],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"b1503bb2-74cf-4ec7-be60-ca7954690036"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request.TokenExchange.Actor.iss","id":"cf4de895-4cb5-4d76-82b6-bee9b7fe09f0","name":"iss","numberOfChildren":null,"parentId":"13ae049a-9748-4669-b991-1b9989db4ba0","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"2cbd3707-14a6-4e46-a881-64dc522029b7"},{"objectType":"AttributeDefinition","defaultValue":"no-sub","description":"","fullName":"Request.TokenExchange.Actor.sub","id":"191dc4cf-3311-43cd-b1e6-24d4aaa0ce54","name":"sub","numberOfChildren":null,"parentId":"13ae049a-9748-4669-b991-1b9989db4ba0","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"210b3154-660e-4ede-8a42-8bc424a76ce1"},{"objectType":"AttributeDefinition","defaultValue":"urn:ietf:params:oauth:token-type:jwt","description":"","fullName":"Request.TokenExchange.Actor.token_type","id":"9dcb3317-9643-418a-a392-91817df67de3","name":"token_type","numberOfChildren":null,"parentId":"13ae049a-9748-4669-b991-1b9989db4ba0","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"d23caac8-bc34-4ade-8e0a-e35d2278520c"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request.TokenExchange.Actor.token","id":"f4617398-1270-48b2-a7b0-14e8df2d4a7e","name":"token","numberOfChildren":null,"parentId":"13ae049a-9748-4669-b991-1b9989db4ba0","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"09aac9f9-e318-4652-899b-cc98020d476e"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request.TokenExchange.Subject","id":"80eaac8c-c618-4849-a786-1fd8c82f2094","name":"Subject","numberOfChildren":4,"parentId":"4270cdd7-2b6a-4539-a29d-b9f0f56a762a","repetitionSource":null,"resolvers":[],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"15facb3e-c6bf-4786-bc95-1f7762cc81a1"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request.TokenExchange.Subject.iss","id":"b6dcf6b7-5187-496a-9c4f-a7370e109336","name":"iss","numberOfChildren":null,"parentId":"80eaac8c-c618-4849-a786-1fd8c82f2094","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"3ba52c5a-6cff-4c9c-a4e9-eecfe8f261b6"},{"objectType":"AttributeDefinition","defaultValue":"no-sub","description":"","fullName":"Request.TokenExchange.Subject.sub","id":"7ccd38e8-8ef4-46b9-a1ce-4a5b0328c8f7","name":"sub","numberOfChildren":null,"parentId":"80eaac8c-c618-4849-a786-1fd8c82f2094","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"9a3f95bb-8ce2-4849-997b-12f3efeda7d2"},{"objectType":"AttributeDefinition","defaultValue":"urn:ietf:params:oauth:token-type:jwt","description":"","fullName":"Request.TokenExchange.Subject.token_type","id":"fc0546cf-89b5-4418-8e22-3522ef47cce9","name":"token_type","numberOfChildren":null,"parentId":"80eaac8c-c618-4849-a786-1fd8c82f2094","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"4c968dcf-5982-4400-b8ac-debc4af78f32"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request.TokenExchange.Subject.token","id":"cb20a125-e3ce-46ad-8950-edbe83752de4","name":"token","numberOfChildren":null,"parentId":"80eaac8c-c618-4849-a786-1fd8c82f2094","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"cfba96f9-15a1-4c1a-83b2-3d1eba5d0761"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request.TokenExchange.aud","id":"ac9ae56b-2e5a-408a-b793-0f4dc26db095","name":"aud","numberOfChildren":null,"parentId":"4270cdd7-2b6a-4539-a29d-b9f0f56a762a","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"f6f80a69-ca56-4330-ab29-ccdce1e02eb1"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Request.TokenExchange.scope","id":"8d80fa4e-adf4-4680-a8cd-075251e0be1d","name":"scope","numberOfChildren":null,"parentId":"4270cdd7-2b6a-4539-a29d-b9f0f56a762a","repetitionSource":null,"resolvers":[{"attributeResolverType":"request","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":{"type":"spel","expression":"#string.split(#root.value, null)","valueType":"COLLECTION","name":""},"valueSchema":null,"valueType":"COLLECTION","version":"774319cf-b188-4351-b7eb-66359bf3cfff"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"TokenExchange","id":"81737485-633d-429c-9168-c4363f39173b","name":"TokenExchange","numberOfChildren":5,"parentId":null,"repetitionSource":null,"resolvers":[],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"54f1918c-d7d7-42fd-a8bc-8bdf200291f0"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"TokenExchange.Allowed Audiences","id":"54b24b81-55fc-4e10-b111-8d8823293d19","name":"Allowed Audiences","numberOfChildren":null,"parentId":"81737485-633d-429c-9168-c4363f39173b","repetitionSource":null,"resolvers":[{"attributeResolverType":"constant","value":"[\n    \"gateway\", \n    \"https://notflux-api.ping-devops.com\", \n    \"https://notflux-mcp-kong.ping-devops.com\",\n    \"http://notflux-api.notflux.svc.cluster.local\",\n     \"notflux-mcp\",\n     \"notflux-agent\",\n     \"http://notflux-api.notflux.svc.cluster.local\",\n     \"registry-agent\"\n]","type":"JSON","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"COLLECTION","version":"a0bc1be9-231e-4744-8f82-8c3964dd5441"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"TokenExchange.Allowed Scopes","id":"b53ae197-29dd-4158-b091-18f50c8491f7","name":"Allowed Scopes","numberOfChildren":null,"parentId":"81737485-633d-429c-9168-c4363f39173b","repetitionSource":null,"resolvers":[{"attributeResolverType":"constant","value":"[\n    \"use_gateway\",\n    \"use_mcp_tools\",\n    \"get_media\",\n    \"manage_account\",\n    \"manage_profiles\",\n    \"use_agent\",\n    \"registry-agent\"\n]","type":"JSON","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"COLLECTION","version":"3c43a3a5-245c-4502-8e64-9211270300ea"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"TokenExchange.Trusted Issuers","id":"2fb58a97-2a57-49a0-982a-a67c1588909e","name":"Trusted Issuers","numberOfChildren":null,"parentId":"81737485-633d-429c-9168-c4363f39173b","repetitionSource":null,"resolvers":[{"attributeResolverType":"constant","value":"[\n    \"https://auth.pingone.com/59bb6a66-e76e-490c-b83a-884c50423da4/as\", \n    \"https://oidc.eks.us-east-2.amazonaws.com/id/9ACBE86EA026DE86EFC05A61A5F83B30\",\n    \"https://notflux-tokens.ping-devops.com\",\n    \"https://accounts.google.com\"\n]","type":"JSON","condition":{"empty":{}},"valueProcessor":null,"name":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"COLLECTION","version":"3dafa138-ac36-4fa8-b411-e1fbf9916c0e"},{"objectType":"ConditionDefinition","condition":{"empty":{}},"description":"","fullName":"Token Exchange","id":"9bbbebe6-f993-4218-8559-bf798e334f4a","name":"Token Exchange","numberOfChildren":2,"parentId":null,"type":"CONDITION","version":"0b1142a2-e811-48dd-a8e4-c5b3abaf21a6"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"Parent attribute for the user the decision request is being made on behalf of\n(See PingOne.User.ID for details on how the user is identified from the decision request)\nThis value is resolved from the userContext.userId property of the decision request.","fullName":"PingOne.User","id":"c9c69ef1-4623-4913-81d4-75466831777d","managedEntity":{"owner":{"service":{"name":"Editor Service"}},"restrictions":{"disallowChildren":false,"readOnly":true}},"name":"User","numberOfChildren":5,"parentId":"b530f05b-a30d-4932-87e9-fabd65121ec3","repetitionSource":null,"resolvers":[{"attributeResolverType":"user","name":null,"query":{"type":"userIdQuery","userIdAttribute":"5c357b78-e4a3-4c5f-9716-bd8fd718ac64"},"condition":null,"valueProcessor":null}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":"{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"preferredLanguage\": {\n      \"type\": \"string\",\n      \"displayName\": \"Preferred Language\",\n      \"description\": \"The user's preferred written or spoken languages, which are optional. This may be explicitly set to null when updating a user to unset it. If provided, the format of the value is the same as the HTTP Accept-Language header field (not including \\\"Accept-Language:\\\") and is specified in Section 5.3.5 of RFC 7231.\",\n      \"schemaType\": \"STANDARD\"\n    },\n    \"timezone\": {\n      \"type\": \"string\",\n      \"displayName\": \"Timezone\",\n      \"description\": \"The user's time zone, which is optional. This may be explicitly set to null when updating a user to unset it. If provided, it must conform with the IANA Time Zone database format [RFC6557], also known as the \\\"Olson\\\" time zone database format [Olson-TZ] (e.g., \\\"America/Los_Angeles\\\")\",\n      \"schemaType\": \"STANDARD\"\n    },\n    \"lastSignOn\": {\n      \"type\": \"object\",\n      \"displayName\": \"Last Sign-on\",\n      \"description\": \"Last Sign-on Information\",\n      \"schemaType\": \"CORE\",\n      \"properties\": {\n        \"at\": {\n          \"type\": \"string\",\n          \"displayName\": \"Last Sign-on Time\",\n          \"description\": \"The time of the last successful login of the user via the Flow API.\",\n          \"schemaType\": \"CORE\"\n        },\n        \"remoteIp\": {\n          \"type\": \"string\",\n          \"displayName\": \"Last Sign-on Remote IP\",\n          \"description\": \"The IP address of the last successful login of the user via the Flow API.\",\n          \"schemaType\": \"CORE\"\n        }\n      }\n    },\n    \"title\": {\n      \"type\": \"string\",\n      \"displayName\": \"Title\",\n      \"description\": \"The user's title, which is optional, such as \\\"Vice President\\\". This may be explicitly set to null when updating a user to unset it.\",\n      \"schemaType\": \"STANDARD\"\n    },\n    \"type\": {\n      \"type\": \"string\",\n      \"displayName\": \"Type\",\n      \"description\": \"The user's type, which is optional. This may be explicitly set to null when updating a user to unset it. This attribute is organization-specific and has no special meaning within the platform. It could have values of \\\"Contractor\\\", \\\"Employee\\\", \\\"Intern\\\", \\\"Temp\\\", \\\"External\\\", and \\\"Unknown\\\"\",\n      \"schemaType\": \"STANDARD\"\n    },\n    \"locale\": {\n      \"displayName\": \"Locale\",\n      \"description\": \"The user's default location, which is optional. This may be explicitly set to null when updating a user to unset it. This is used for purposes of localizing such items as currency, date time format, or numerical representations. If provided, a valid value is a language tag as defined in RFC 5646. The following are example tags: fr, en-US, es-419, az-Arab, x-pig-latin, man-Nkoo-GN\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"string\"\n    },\n    \"enabled\": {\n      \"displayName\": \"Enabled\",\n      \"description\": \"A read-only attribute that specifies whether the user is enabled. This attribute is set to 'true' by default when the user is created.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"boolean\"\n    },\n    \"identityProvider\": {\n      \"displayName\": \"Identity Provider\",\n      \"description\": \"A read-only attribute that contains information about the user's trusted identity provider.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"displayName\": \"Identity Provider ID\",\n          \"description\": \"An attribute containing the ID of the identity provider that is used as the authentication authority for the user. If present, the user must authenticate via this identity provider.\",\n          \"schemaType\": \"CORE\",\n          \"type\": \"string\"\n        },\n        \"type\": {\n          \"displayName\": \"Identity Provider Type\",\n          \"description\": \"A read-only attribute containing the type of the identity provider where the user account is managed. If the type is PING_ONE, PingOne is the authentication authority.\",\n          \"schemaType\": \"CORE\",\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"lifecycle\": {\n      \"displayName\": \"lifecycle\",\n      \"description\": \"The account lifecycle\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"status\": {\n          \"displayName\": \"Status\",\n          \"description\": \"The lifecycle status for this account.\",\n          \"schemaType\": \"CORE\",\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"createdAt\": {\n      \"displayName\": \"Creation Time\",\n      \"description\": \"A read-only attribute that specifies the time at which the user was created.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"string\"\n    },\n    \"verifyStatus\": {\n      \"displayName\": \"ID Validation Verification Authentication Enabled\",\n      \"description\": \"A read-only attribute that specifies whether ID Validation authentication is enabled. This attribute is set to 'NOT-INITIATED' by default when the user is created.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"string\"\n    },\n    \"nickname\": {\n      \"displayName\": \"Nickname\",\n      \"description\": \"The user's nickname, which is optional. This may be explicitly set to null when updating a user to unset it. Valid characters consists of any Unicode letter, mark (e.g. accent, umlaut), math symbol, numeric character, or punctuation. It may have a length of no more than 256 characters.\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"string\"\n    },\n    \"mfaEnabled\": {\n      \"displayName\": \"Multi-factor Authentication Enabled\",\n      \"description\": \"A read-only attribute that specifies whether multi-factor authentication is enabled. This attribute is set to 'false' by default when the user is created.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"boolean\"\n    },\n    \"id\": {\n      \"displayName\": \"User ID\",\n      \"description\": \"The globally unique identifier of the user.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"string\"\n    },\n    \"email\": {\n      \"displayName\": \"Email Address\",\n      \"description\": \"The user's email address\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"string\"\n    },\n    \"updatedAt\": {\n      \"displayName\": \"Last Modified Time\",\n      \"description\": \"A read-only attribute that specifies the time at which the user was last modified.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"string\"\n    },\n    \"address\": {\n      \"displayName\": \"Address\",\n      \"description\": \"The user's address (optional)\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"streetAddress\": {\n          \"displayName\": \"Street Address\",\n          \"description\": \"The full street address component, which may include house number, street name, P.O. box, and multi-line extended street address information. This attribute may contain newlines.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        },\n        \"locality\": {\n          \"displayName\": \"Locality\",\n          \"description\": \"The city or locality component of the address.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        },\n        \"region\": {\n          \"displayName\": \"Region\",\n          \"description\": \"The state or region component of the address.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        },\n        \"postalCode\": {\n          \"displayName\": \"Postal Code\",\n          \"description\": \"The zip code or postal code component of the address.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        },\n        \"countryCode\": {\n          \"displayName\": \"Country Code\",\n          \"description\": \"The country name component. When specified, the value MUST be in ISO 3166-1 \\\"alpha-2\\\" code format [ISO3166]; e.g., the United States and Sweden are \\\"US\\\" and \\\"SE\\\", respectively.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"externalId\": {\n      \"displayName\": \"External ID\",\n      \"description\": \"An identifier for the user resource as defined by the provisioning client. This is optional. This may be explicitly set to null when updating a user to unset it. The externalId attribute may simplify the correlation of the user in PingOne with the user's account in another system of record. The platform does not use this attribute directly in any way, but it is used by Ping Identity's Data Sync product.\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"string\"\n    },\n    \"photo\": {\n      \"displayName\": \"Photo\",\n      \"description\": \"The user's photo URL (optional)\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"href\": {\n          \"displayName\": \"Photos Link\",\n          \"description\": \"A URI that is a uniform resource locator (as defined in Section 1.1.3 of RFC 3986) that points to a resource location representing the user's image. This may be removed from a user by setting the photo attribute to null. If provided, the resource must be a file (e.g., a GIF, JPEG, or PNG image file) rather than a web page containing an image. It must also have a scheme of http or https.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"population\": {\n      \"displayName\": \"Population\",\n      \"description\": \"The name of the population in which the user’s identity exists.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"displayName\": \"Population ID\",\n          \"description\": \"The unique identifier for the population in which the user’s identity exists.\",\n          \"schemaType\": \"CORE\",\n          \"type\": \"sring\"\n        }\n      }\n    },\n    \"primaryPhone\": {\n      \"displayName\": \"Primary Phone\",\n      \"description\": \"The user's primary phone number, which is optional. This might also match the mobilePhone attribute. This may be explicitly set to null when updating a user to unset it. If provided, it must consist of at least one digit and must not contain more than 32 characters.\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"string\"\n    },\n    \"accountId\": {\n      \"displayName\": \"Account ID\",\n      \"description\": \"The user's account ID, which is optional. This may be explicitly set to null when updating a user to unset it. This attribute is organization-specific and has no special meaning within the platform.\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"string\"\n    },\n    \"emailVerified\": {\n      \"displayName\": \"Email Verified\",\n      \"description\": \"A read-only attribute that specifies whether the email is verified.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"boolean\"\n    },\n    \"mobilePhone\": {\n      \"displayName\": \"Mobile Phone\",\n      \"description\": \"The user's mobile phone number, which is optional. This might also match the primaryPhone attribute. This may be explicitly set to null when updating a user to unset it. If provided, it must consist of at least one digit and must not contain more than 32 characters.\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"string\"\n    },\n    \"name\": {\n      \"displayName\": \"Name\",\n      \"description\": \"The user's name (optional)\",\n      \"schemaType\": \"STANDARD\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"formatted\": {\n          \"displayName\": \"Formatted\",\n          \"description\": \"The fully formatted name of the User (for example 'Ms. Barbara J Jensen, III'). This may be explicitly set to null when updating a name to unset it.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        },\n        \"given\": {\n          \"displayName\": \"Given Name\",\n          \"description\": \"The given name of the User, or First in most Western languages (for example, 'Barbara' given the full name 'Ms. Barbara J Jensen, III'). This may be explicitly set to null when updating a name to unset it. Valid characters consists of any Unicode letter, mark (e.g. accent, umlaut), math symbol, numeric character, or punctuation. It may have a length of no more than 256 characters.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        },\n        \"middle\": {\n          \"displayName\": \"Middle Name\",\n          \"description\": \"The the middle name(s) of the User (e.g., 'Jane' given the full name 'Ms. Barbara Jane Jensen, III'). This may be explicitly set to null when updating a name to unset it. Valid characters consists of any Unicode letter, mark (e.g. accent, umlaut), math symbol, numeric character, or punctuation. It may have a length of no more than 256 characters.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        },\n        \"family\": {\n          \"displayName\": \"Family Name\",\n          \"description\": \"The family name of the User, or Last in most Western languages (for example, 'Jensen' given the full name 'Ms. Barbara J Jensen, III'). This may be explicitly set to null when updating a name to unset it. Valid characters consists of any Unicode letter, mark (e.g. accent, umlaut), math symbol, numeric character, or punctuation. It may have a length of no more than 256 characters.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        },\n        \"honorificPrefix\": {\n          \"displayName\": \"Honorific Prefix\",\n          \"description\": \"The honorific prefix(es) of the User, or title in most Western languages (e.g., 'Ms.' given the full name 'Ms. Barbara Jane Jensen, III'). This may be explicitly set to null when updating a name to unset it.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        },\n        \"honorificSuffix\": {\n          \"displayName\": \"Honorific Suffix\",\n          \"description\": \"The honorific suffix(es) of the User, or suffix in most Western languages (e.g., 'III' given the full name 'Ms. Barbara Jane Jensen, III'). This may be explicitly set to null when updating a name to unset it.\",\n          \"schemaType\": \"STANDARD\",\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"account\": {\n      \"displayName\": \"Account\",\n      \"description\": \"A read-only attribute that contains information about the user's account\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"canAuthenticate\": {\n          \"displayName\": \"Can Authenticate\",\n          \"description\": \"A read-only attribute that specifies whether the user can authenticate at this time.\",\n          \"schemaType\": \"CORE\",\n          \"type\": \"boolean\"\n        },\n        \"status\": {\n          \"displayName\": \"Account Status\",\n          \"description\": \"A read-only attribute that specifies the status of the account.\",\n          \"schemaType\": \"CORE\",\n          \"type\": \"string\"\n        },\n        \"lockedAt\": {\n          \"displayName\": \"Locked Time\",\n          \"description\": \"A read-only attribute that specifies the time at which the account was locked, if any.\",\n          \"schemaType\": \"CORE\",\n          \"type\": \"string\"\n        },\n        \"secondsUntilUnlock\": {\n          \"displayName\": \"Seconds Until Unlock\",\n          \"description\": \"A read-only attribute that specifies the number of seconds remaining until the account will be unlocked.\",\n          \"schemaType\": \"CORE\",\n          \"type\": \"string\"\n        },\n        \"unlockAt\": {\n          \"displayName\": \"Unlock Time\",\n          \"description\": \"A read-only attribute that specifies the time at which the account will be unlocked.\",\n          \"schemaType\": \"CORE\",\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"username\": {\n      \"displayName\": \"Username\",\n      \"description\": \"The username, which must be provided and must be unique within an environment. The username must be a string of any Unicode letter, mark (e.g. accent, umlaut), math symbol, numeric character, or punctuation. It may have a length of no more than 128 characters.\",\n      \"schemaType\": \"CORE\",\n      \"type\": \"string\"\n    }\n  }\n}","valueType":"JSON","version":"2c7e6423-36fa-4cf2-995f-a91908a733b4"},{"objectType":"ConditionDefinition","condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"191dc4cf-3311-43cd-b1e6-24d4aaa0ce54"}},"op":"NotEquals","right":{"constant":{"value":"no-sub"}}}}]}},"description":"","fullName":"Token Exchange.Actor Token is Present?","id":"e2a9dca1-235a-4b15-99e2-b42310e2480c","name":"Actor Token is Present?","numberOfChildren":null,"parentId":"9bbbebe6-f993-4218-8559-bf798e334f4a","type":"CONDITION","version":"b5c804fc-7d35-4105-8537-0ee85a89a2dd"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Introspection.ClientSecret","id":"08c36921-e5e4-4bca-8b42-7673e2788dff","name":"ClientSecret","numberOfChildren":null,"parentId":"9e3eee3b-e5d3-4e38-a890-d69f8d1420d1","repetitionSource":null,"resolvers":[{"attributeResolverType":"constant","value":"DCf0rvCOLUNo7Q-CVB8AhH3WbHz.dk12QUoNchpzc5P5h2i28Lt5SEt0lN6qUm7~","type":"STRING","condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"b6dcf6b7-5187-496a-9c4f-a7370e109336"}},"op":"Equals","right":{"constant":{"value":"https://auth.pingone.com/59bb6a66-e76e-490c-b83a-884c50423da4/as"}}}}]}},"valueProcessor":null,"name":"PingOne - NotFlux"}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","version":"42e94600-a029-4ed8-b9c5-6b178c5c8df0"},{"objectType":"AttributeDefinition","defaultValue":null,"description":"","fullName":"Introspection.Endpoint","id":"de5d65e3-3b0c-4dfa-b1a2-6172401b3ee5","name":"Endpoint","numberOfChildren":null,"parentId":"9e3eee3b-e5d3-4e38-a890-d69f8d1420d1","repetitionSource":null,"resolvers":[{"attributeResolverType":"constant","value":"/introspect","type":"STRING","condition":{"and":{"conditions":[{"comparison":{"left":{"attribute":{"id":"b6dcf6b7-5187-496a-9c4f-a7370e109336"}},"op":"Equals","right":{"constant":{"value":"https://auth.pingone.com/59bb6a66-e76e-490c-b83a-884c50423da4/as"}}}}]}},"valueProcessor":null,"name":"PingOne - NotFlux"}],"type":"ATTRIBUTE","valueProcessor":null,"valueSchema":null,"valueType":"STRING","vers